#!/usr/bin/env python3

# python host script setup
import os, subprocess, platform
from pathlib import Path

if os.name == "nt":
    from colorama import Fore, init

def create_repo_if_unavailable(path):
    if not os.path.exists(path):
        os.makedirs(path)

def list_folders(p, name_filter=None):
    dir_filter = lambda f: (f.is_dir() and name_filter in f.name) if name_filter else f.is_dir()
    return [f.name for f in p.iterdir() if dir_filter(f)]

def print_welcome_message(root_path):
    print("###################################################################")
    print("# Welcome to BitBauga. You have now initialized your environment! #")
    print("###################################################################")
    print("\nMeta-Layers:\n -", '\n - '.join(list_folders(root_path, "meta")), '\n')

def configure_os_helpers(script_path):
    if os.name == "nt":
        commands = f"""
            function bitbauga {{
                python "{script_path}/bitbauga" @args
            }}
            function devtool {{
                python "{script_path}/devtool" @args
            }}
            Write-Host "Dynamic devtool and Bitbauga loaded!" -ForegroundColor Green
        """

        powershell_helper = os.path.join(os.environ.get("BB_TEMP_DIR"), "init_env.ps1")
        with open(powershell_helper, "w") as f:
            f.write(commands)

        init(autoreset=True)
        print(Fore.YELLOW + "Run this in your PowerShell terminal to load them:")
        print(Fore.WHITE + f" . '{powershell_helper}'\n")
    else:
        os.environ["PATH"] += os.pathsep + str(script_path)

# Root directory
bitbauga_path = Path(os.path.dirname(os.path.realpath(__file__)))
root_path = bitbauga_path / ".."
os.chdir(root_path)

# Standard relevant folders
build_path = bitbauga_path / "build"            # Build target directories
temp_path = bitbauga_path / "tmp"               # Temporary data
workspace_path = bitbauga_path / "workspace"    # Checked out recipes
script_path = bitbauga_path / "scripts"

# Setup environment variables
os.environ["BB_ROOT_DIR"] = str(root_path)
os.environ["BB_TEMP_DIR"] = str(temp_path)
os.environ["BB_BUILD_DIR"] = str(build_path)
os.environ["BB_WORKSPACE"] = str(workspace_path)

# Create directories
create_repo_if_unavailable(temp_path)
create_repo_if_unavailable(build_path)
create_repo_if_unavailable(workspace_path)

print_welcome_message(root_path)

# OS specific prep
configure_os_helpers(script_path)

# Automatically detect host shell and drop user into configured environment
shell = os.environ.get("SHELL") or ("powershell.exe -NoLogo" if platform.system() == "Windows" else "bash")
subprocess.run(shell.split(' '))
