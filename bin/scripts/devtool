#!/usr/bin/env python3

import os, sys
from argparse import Namespace, ArgumentParser, ArgumentTypeError
from pathlib import Path
from abc import ABC, abstractmethod
from helpers import *


class IParserStructure(ABC):
    @abstractmethod
    def handle_callback(self, args: Namespace) -> int:
        pass

    def setup(self):
        pass

    def __init__(self, parser: ArgumentParser):
        self.parser = parser
        self.setup()
        parser.set_defaults(func=self.handle_callback)

    @staticmethod
    def char_set_validator(allowed_set: set):
        """Ensures every character in the argument is within allowed_set."""
        def validator(value: str) -> str:
            invalid_chars = set(value) - allowed_set
            if invalid_chars:
                raise ArgumentTypeError(
                    f"Invalid characters found: '{', '.join(sorted(invalid_chars))}'. "
                    f"Allowed characters are: '{''.join(sorted(allowed_set))}'"
                )
            return value
        return validator


class ListParser(IParserStructure):
    def handle_callback(self, args: Namespace) -> int:
        directory = Path(os.environ["BB_ROOT_DIR"])

        match args.item:
            case 'layers':
                items = [
                    d.name for d in directory.iterdir()
                    if d.is_dir() and d.name.startswith("meta")
                ]
            case 'recipes':
                items = [
                    Recipe(f).name for f in directory.rglob("meta*/recipe-*/*/*_*.bb")
                    if f.is_file()
                ]
            case 'categories':
                items = [
                    g.name for g in directory.rglob("meta*/recipe-*")
                    if g.is_dir() and g.name.startswith("recipe-")
                ]
            case _:
                return -1;

        if args.verbose:
            print("--> Running in verbose mode...")
            print(f"Target item: {args.item}")

        if args.filter:
            items = [ i for i in items if args.filter in i ]

        if args.limit and len(items) > args.limit:
            items = items[1:(args.limit + 1)]

        print('\n'.join(items))
        return 0

    def setup(self):
        self.parser.add_argument(
            "item",
            choices=["layers", "recipes", "categories"],
            help="list devtool items (default: 'layers')."
        )

        self.parser.add_argument(
            "-l", "--limit",
            type=int,
            default=None,
            help="Maximum number of items to return (default: None)."
        )

        self.parser.add_argument(
            "-v", "--verbose",
            action="store_true",
            default=False,
            help="Enable detailed verbose output (default: False)."
        )

        self.parser.add_argument(
            "-f", "--filter",
            type=str,
            default=None,
            help="Filter by name (default: None)."
        )


class ModifyParser(IParserStructure):
    def handle_callback(self, args: Namespace) -> int:
        print("TODO: Modify repo: {recipes}")
        return 0


class InspectParser(IParserStructure):
    def handle_callback(self, args: Namespace) -> int:
        directory = Path(os.environ["BB_ROOT_DIR"])

        matching_recipe_paths = [f for f in directory.rglob(f"meta*/recipe-*/*/{args.recipe}_*.bb")]
        if len(matching_recipe_paths) == 0:
            print(f"No matching recipe found to {args.recipe}")
            return -1

        if len(matching_recipe_paths) > 1:
            print(f"Conflicting recipes found to {args.recipe}")
            return -1

        recipe = Recipe(matching_recipe_paths[0]).parse_recipe()
        print(recipe.__str__(verbose=args.verbose))

        return 0

    def setup(self):
        self.parser.add_argument(
            "recipe",
            type=str,
            default=None,
            help="Inspect devtool recipe."
        )

        self.parser.add_argument(
            "-v", "--verbose",
            action="store_true",
            default=False,
            help="Enable detailed verbose output (default: False)."
        )


class DatabaseParser(IParserStructure):
    def handle_callback(self, args: Namespace) -> int:
        db = SStateCache(verbose=args.verbose)
        directory = Path(os.environ["BB_ROOT_DIR"])

        file_ext = type_str_to_extension_str(args.type) or "*"
        assert(file_ext is not None)

        layer = args.layer or 'meta*'
        item = args.item or '*'
        file_query = f"{item}_*.{file_ext}" if (args.type == "recipe" or args.type == "append") else f"{item}.{file_ext}"
        file_paths = set()

        if args.type in ["recipe", "include", "append", "all"]:
            file_paths.update([f for f in directory.rglob(f"{layer}/recipe-*/*/{file_query}")])

        if args.type in ["class", "include", "all"]:
            file_paths.update([f for f in directory.rglob(f"{layer}/classes/{file_query}")])

        if args.type in ["include", "config", "all"]:
            file_paths.update([f for f in directory.rglob(f"{layer}/conf/*/*/include/{file_query}")] \
                            + [f for f in directory.rglob(f"{layer}/conf/*/{file_query}")] \
                            + [f for f in directory.rglob(f"{layer}/conf/{file_query}")])

        match args.operation:
            case "clear":
                if not args.force:
                    print("Are you sure you want to clear the cache? Use '--force' to enable.")
                    return -1

                if args.layer is None and args.item is None:
                    db.clear_cache()
                    print("Cleared the full cache")
                else:
                    db.batch_remove_files(file_paths)

            case "scan":
                db.batch_track_files(file_paths)

            case "query": # Query the database
                no_filter = (args.layer is None) and (args.item is None) and (args.type == "all")
                if no_filter and not args.force:
                    print("Are you sure you want to query all layers and files? Use '--force' to enable.")
                    return -1

                ignored_type = None if args.type == "all" else args.type
                db_entries = db.find_files(args.layer, ignored_type, args.item)
                for entry in db_entries:
                    print(entry.__str__(args.verbose))

        return 0

    def setup(self):
        self.parser.add_argument(
            "operation",
            choices=[
                "clear", # Clear files
                "scan",  # Scan files
                "query"  # Query the scanned database
            ],
            default=None,
            help="List database operations (default: None)."
        )

        self.parser.add_argument(
            "-i", "--item",
            default=None,
            type=IParserStructure.char_set_validator(ALLOWED_LAYER_RECIPE_CHARACTERS),
            help="Database file items (default: All files)."
        )

        self.parser.add_argument(
            "-t", "--type",
            default="all",
            choices=[
                "recipe",   # Recipes - bb
                "class",    # Classes - bbclass
                "include",  # Include - inc
                "config",   # Config  - conf
                "append",   # Append  - bbappend
                "all"       # All types
            ],
            type=IParserStructure.char_set_validator(ALLOWED_LAYER_RECIPE_CHARACTERS),
            help="Database file type (default: 'all')."
        )

        self.parser.add_argument(
            "-l", "--layer",
            default=None,
            type=IParserStructure.char_set_validator(ALLOWED_LAYER_RECIPE_CHARACTERS),
            help="Apply command to specific layer only (default: All layers)."
        )

        self.parser.add_argument(
            "-f", "--force",
            action="store_true",
            default=False,
            help="Force command. Required for certain critical operations (default: False)."
        )

        self.parser.add_argument(
            "-v", "--verbose",
            action="store_true",
            default=False,
            help="Enable detailed verbose output (default: False)."
        )


def main() -> int:
    parser = ArgumentParser(description="Devtool utility")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # List subparser
    ListParser(subparsers.add_parser("list", help="List devtool items"))
    ModifyParser(subparsers.add_parser("modify", help="Modify devtool repos"))
    InspectParser(subparsers.add_parser("inspect", help="Inspect devtool recipes"))
    DatabaseParser(subparsers.add_parser("database", help="Interact with database"))

    # Parse inputs and dispatch directly to handle_list
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
