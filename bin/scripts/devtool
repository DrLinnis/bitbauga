#!/usr/bin/env python3

import os, sys
from argparse import Namespace, ArgumentParser
from pathlib import Path
from abc import ABC, abstractmethod
from helpers import Recipe


class IParserStructure(ABC):
    @abstractmethod
    def handle_callback(self, args: Namespace) -> int:
        pass

    def setup(self):
        pass

    def __init__(self, parser: ArgumentParser):
        self.parser = parser
        self.setup()
        parser.set_defaults(func=self.handle_callback)


class ListParser(IParserStructure):
    def handle_callback(self, args: Namespace) -> int:
        directory = Path(os.environ["BB_ROOT_DIR"])

        match args.item:
            case 'layers':
                items = [
                    d.name for d in directory.iterdir()
                    if d.is_dir() and d.name.startswith("meta")
                ]
            case 'recipes':
                items = [
                    Recipe(f).name for f in directory.rglob("meta*/recipe-*/*/*_*.bb")
                    if f.is_file()
                ]
            case 'categories':
                items = [
                    g.name for g in directory.rglob("meta*/recipe-*")
                    if g.is_dir() and g.name.startswith("recipe-")
                ]
            case _:
                return -1;

        if args.verbose:
            print("--> Running in verbose mode...")
            print(f"Target item: {args.item}")

        if args.filter:
            items = [ i for i in items if args.filter in i ]

        if args.limit and len(items) > args.limit:
            items = items[1:(args.limit + 1)]

        print('\n'.join(items))
        return 0

    def setup(self):
        self.parser.add_argument(
            "item",
            choices=["layers", "recipes", "categories"],
            help="list devtool items (default: 'layers')."
        )

        self.parser.add_argument(
            "-l", "--limit",
            type=int,
            default=None,
            help="Maximum number of items to return (default: None)."
        )

        self.parser.add_argument(
            "-v", "--verbose",
            action="store_true",
            default=False,
            help="Enable detailed verbose output (default: False)."
        )

        self.parser.add_argument(
            "-f", "--filter",
            type=str,
            default=None,
            help="Filter by name (default: None)."
        )


class ModifyParser(IParserStructure):
    def handle_callback(self, args: Namespace) -> int:
        print("TODO: Modify repo: {recipes}")
        return 0


class InspectParser(IParserStructure):
    def handle_callback(self, args: Namespace) -> int:
        print("TODO: Inspect recipe: {recipes}")
        return 0

    def setup(self):
        pass


def main() -> int:
    parser = ArgumentParser(description="Devtool utility")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # List subparser
    ListParser(subparsers.add_parser("list", help="List devtool items"))
    ModifyParser(subparsers.add_parser("modify", help="Modify devtool repos"))
    InspectParser(subparsers.add_parser("inspect", help=" Inspect devtool recipes"))

    # Parse inputs and dispatch directly to handle_list
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
